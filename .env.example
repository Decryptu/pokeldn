# The network bridge (firmware/bridge): its address on your network and its TCP port.
# The bridge's setup page (http://pokeldn-bridge/) shows both.
BRIDGE_HOST=192.168.1.50
BRIDGE_PORT=47811

# The port the web app answers on: http://SERVER:WEB_PORT
WEB_PORT=8550

# The folder holding prod.keys
KEYS_DIR=./keys

TZ=Europe/Berlin

# Keep every run's output in docker-data/logs (unredacted: trainer names and IDs included)
#RUN_LOG=/data/logs
