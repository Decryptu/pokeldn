diff --git a/Makefile b/Makefile
index ed46644..3bea708 100644
--- a/Makefile
+++ b/Makefile
@@ -2,12 +2,30 @@
 TITLE       := POKEMON EMER
 GAME_CODE   := BPEE
 MAKER_CODE  := 01
-REVISION    := 0
+REVISION    ?= 0
+# The Switch FireRed/LeafGreen cartridge the ROM replaces: the wrapper patches librfu_sio32id.o and
+# librfu_intr.o at that cartridge's addresses. The Japanese carts place them below Emerald's .text end.
+SWITCH_CART ?= BPRE
+SLOOP_RFU_ADDR_BPRD := 0x081E702C
+SLOOP_RFU_ADDR_BPRE := 0x081E2814
+SLOOP_RFU_ADDR_BPRF := 0x081E1568
+SLOOP_RFU_ADDR_BPRI := 0x081E0200
+SLOOP_RFU_ADDR_BPRS := 0x081E28C8
+SLOOP_RFU_ADDR_BPGD := 0x081E7008
+SLOOP_RFU_ADDR_BPGE := 0x081E27F0
+SLOOP_RFU_ADDR_BPGF := 0x081E1544
+SLOOP_RFU_ADDR_BPGI := 0x081E01DC
+SLOOP_RFU_ADDR_BPGS := 0x081E28A4
+SLOOP_RFU_ADDR ?= $(SLOOP_RFU_ADDR_$(SWITCH_CART))
 MODERN      ?= 0
 KEEP_TEMPS  ?= 0
 
 # `File name`.gba ('_modern' will be appended to the modern builds)
+ifeq ($(REVISION),10)
+FILE_NAME := pokeemerald_switch_$(SWITCH_CART)
+else
 FILE_NAME := pokeemerald
+endif
 BUILD_DIR := build
 
 # Builds the ROM using a modern compiler
@@ -68,7 +86,11 @@ else
 endif
 
 ROM_NAME := $(FILE_NAME).gba
+ifeq ($(REVISION),10)
+OBJ_DIR_NAME := $(BUILD_DIR)/emerald_switch_$(SWITCH_CART)
+else
 OBJ_DIR_NAME := $(BUILD_DIR)/emerald
+endif
 MODERN_ROM_NAME := $(FILE_NAME)_modern.gba
 MODERN_OBJ_DIR_NAME := $(BUILD_DIR)/modern
 ASSETS_DIR_NAME := $(BUILD_DIR)/assets
@@ -105,14 +127,14 @@ MID_BUILDDIR = $(OBJ_DIR)/$(MID_SUBDIR)
 SHELL := bash -o pipefail
 
 # Set flags for tools
-ASFLAGS := -mcpu=arm7tdmi --defsym MODERN=$(MODERN)
+ASFLAGS := -mcpu=arm7tdmi --defsym MODERN=$(MODERN) --defsym REVISION=$(REVISION)
 
 INCLUDE_DIRS := include
 INCLUDE_CPP_ARGS := $(INCLUDE_DIRS:%=-iquote %)
 INCLUDE_SCANINC_ARGS := $(INCLUDE_DIRS:%=-I %)
 
 O_LEVEL ?= 2
-CPPFLAGS := $(INCLUDE_CPP_ARGS) -Wno-trigraphs -DMODERN=$(MODERN)
+CPPFLAGS := $(INCLUDE_CPP_ARGS) -Wno-trigraphs -DMODERN=$(MODERN) -DREVISION=$(REVISION)
 ifeq ($(MODERN),0)
   CPPFLAGS += -I tools/agbcc/include -I tools/agbcc -nostdinc -undef -std=gnu89
   CC1 := tools/agbcc/bin/agbcc$(EXE)
@@ -220,6 +242,8 @@ $(shell mkdir -p $(SUBDIRS))
 modern: all
 compare: all
 
+emerald_switch: ; @$(MAKE) REVISION=10
+
 # Other rules
 rom: $(ROM)
 ifeq ($(COMPARE),1)
@@ -369,7 +393,11 @@ endif
 
 # Linker script
 ifeq ($(MODERN),0)
+ifeq ($(REVISION),10)
+LD_SCRIPT := ld_script_switch.ld
+else
 LD_SCRIPT := ld_script.ld
+endif
 LD_SCRIPT_DEPS := $(OBJ_DIR)/sym_bss.ld $(OBJ_DIR)/sym_common.ld $(OBJ_DIR)/sym_ewram.ld $(OBJ_DIR)/memory.ld
 else
 LD_SCRIPT := ld_script_modern.ld
@@ -382,7 +410,7 @@ libagbsyscall:
 	@$(MAKE) -C libagbsyscall TOOLCHAIN=$(TOOLCHAIN) MODERN=$(MODERN)
 
 # Elf from object files
-LDFLAGS = -Map ../../$(MAP)
+LDFLAGS = -Map ../../$(MAP) --defsym SLOOP_RFU_ADDR=$(SLOOP_RFU_ADDR)
 $(ELF): $(LD_SCRIPT) $(LD_SCRIPT_DEPS) $(OBJS) libagbsyscall
 	@cd $(OBJ_DIR) && $(LD) $(LDFLAGS) -T ../../$< --print-memory-usage -o ../../$@ $(OBJS_REL) $(LIB) | grep -v '^ *_'
 	@echo "cd $(OBJ_DIR) && $(LD) $(LDFLAGS) -T ../../$< --print-memory-usage -o ../../$@ <objs> <libs>"
